<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0</Version>
    <PackageId>Wop.Sdk</PackageId>
    <Authors>wop-platform</Authors>
    <PackageProjectUrl>https://github.com/wop-platform/wop-dotnet-sdk</PackageProjectUrl>
    <Description>WOP 网关商户侧官方 .NET SDK：协议核心（套件解析/canonicalRequest/结构化签名/content-digest/L2 数字信封/验签解密）+ HttpClient 适配层。RSA3072/4096 与 SM2-SM3 双套件（BouncyCastle.Cryptography）。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.en.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/wop-platform/wop-dotnet-sdk</RepositoryUrl>
    <PackageTags>wop;gateway;sm2;sm3;sm4;rsa;digital-envelope</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wop.Sdk.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.en.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" />
    <PackageReference Include="System.Memory" Version="4.5.5" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

</Project>
